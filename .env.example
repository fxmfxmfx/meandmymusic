# scripts/setup.py generates .env and these directories for a fresh installation.
APP_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SLSKD_API_KEY=replace-with-a-random-api-key-at-least-16-characters
SOULSEEK_USERNAME=your-soulseek-username
SOULSEEK_PASSWORD=your-soulseek-password

# Existing Navidrome music folder can be mounted here. It must not contain
# INBOX_PATH or STATE_PATH. Back up an existing archive before first use.
MUSIC_PATH=./data/music
INBOX_PATH=./data/inbox
STATE_PATH=./data/state
SLSKD_STATE_PATH=./data/slskd
PUID=1000
PGID=1000

# Bind to loopback by default. Change only when setting up LAN/VPN access.
APP_BIND=127.0.0.1
APP_PORT=8080
SLSKD_UI_BIND=127.0.0.1
SOULSEEK_PORT=50300
SLSKD_IMAGE=slskd/slskd:0.26.2
NAVIDROME_URL=
# Set true when serving the manager behind an HTTPS reverse proxy.
COOKIE_SECURE=false
